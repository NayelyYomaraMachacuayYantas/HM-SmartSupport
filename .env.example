# Copia este archivo como ".env" y coloca tu clave real (NUNCA subas .env a Git)
OPENROUTER_API_KEY=tu_api_key_aqui
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_SITE_URL=http://localhost:8501
# Tamaño del modelo Whisper local para transcribir audio: tiny | base | small
WHISPER_MODEL_SIZE=base
